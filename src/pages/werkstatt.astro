---
import '@fontsource-variable/manrope';
import WorkspaceBridge from '../components/WorkspaceBridge.astro';
import '../styles/workspace-bridge.css';
import '../styles/workbench.css';
import {href} from '../lib/paths';
---
<!doctype html>
<html lang="de">
<head>
  <meta charset="utf-8"/>
  <meta name="viewport" content="width=device-width,initial-scale=1"/>
  <title>Werkstatt · Kleines Schäferrad</title>
  <meta name="robots" content="noindex,nofollow"/>
  <link rel="icon" href={href('favicon.svg')}/>
</head>
<body>
<WorkspaceBridge area="construction"/>
<a class="skip" href="#model-heading">Direkt zum Arbeitsmodell</a>
<header class="wb-header">
  <a href={href('')}>Kleines Schäferrad</a>
  <strong>Werkstatt <span>Aufbau gemeinsam prüfen</span></strong>
  <nav>
    <a href={href('field-pack/KS-Werkstatt-Aufnahmeplan-A3.pdf')}>Arbeitsplan</a>
    <a href={href('feld/')}>Vor Ort arbeiten</a>
  </nav>
</header>

<main id="workbench" data-base={href('')}>
  <div class="wb-statebar"><p id="storage-status" role="status">Lokales Arbeitsprotokoll wird geladen …</p><p>X: Welle · Z: oben · Seitenzuordnung vor Ort bestätigen</p></div>
  <section class="work-question" aria-labelledby="work-question-title"><small>ARBEITSFRAGE · AUSGEWÄHLTES BAUTEIL</small><h1 id="work-question-title">Was ist am heutigen Rad noch offen?</h1><p id="work-question-context">Bauteil auswählen und die zugehörigen Quellen prüfen.</p><a href="#parts">Bauteil auswählen</a><a href="#selection">Eigenschaft prüfen</a><a id="work-field-link" href={href('feld/')}>Befund vor Ort aufnehmen</a><p id="work-context-notice" role="status"></p></section>
  <section class="model-shell" aria-labelledby="model-heading">
    <div class="model-title">
      <div><span class="eyebrow">Arbeitsmodell</span><h2 id="model-heading">Das Rad und sein Tragwerk</h2></div>
      <button id="reset">Zur Ausgangsansicht</button>
    </div>

    <div class="viewer-toolbar">
      <label>Modell<select id="model-mode"><option value="brute">Rekonstruktionskandidat · ITER-003</option><option value="truth">Quellenbasierte Teilgeometrie · Maße offen</option></select></label><label for="scene-mode">Ansicht<select id="scene-mode"><optgroup label="Das System"><option value="gesamt">Gesamtanlage</option><option value="radkoerper">Radkörper</option><option value="tragwerk">Tragwerk</option><option value="betrieb">Betrieb</option></optgroup><optgroup label="Bauteile"><option value="welle">Welle / Arme</option><option value="kranz">Kranz</option><option value="kumpf">Kumpf / Schaufel</option><option value="lager">Lager</option><option value="trog">Trog / Rinne</option></optgroup><optgroup label="Genauer ansehen"><option value="exploded">Auseinandergezogen</option><option value="schnitt">Schnitt</option><option value="evidenz">Quellenstatus</option><option value="scan">Scan-Abgleich</option></optgroup></select></label>
      <button data-view="gesamt" aria-pressed="true">Gesamtanlage</button><button data-view="betrieb">Wasserweg zeigen</button>
      <label class="inline-check"><input id="isolate" type="checkbox"/> Nur Auswahlbereich</label>
    </div>
    <div id="viewport">
      <svg id="axis-triad" viewBox="0 0 84 84" aria-label="Anzeigesystem: X Welle, Z oben, Y quer">
        {['X','Y','Z'].map((a,i)=><g fill={['#24463d','#9b6b32','#242520'][i]} stroke={['#24463d','#9b6b32','#242520'][i]}><line id={'axis-'+a} x1="42" y1="42" x2="42" y2="42" stroke-width="2"/><text id={'label-'+a} stroke="none" font-size="12" text-anchor="middle">{a}</text></g>)}
      </svg>
      <p id="scan-separation" hidden>Scan-Arbeitsplatz · getrennte Maßstäbe · keine Deckung behauptet.</p>
      <div id="canvas-host"></div>
      <div id="scan-host" hidden><span class="scan-panel-label">Punktewolke · noch nicht registriert</span></div>
      <div id="pins" aria-label="Offene Fragen und Messstellen"></div>
      <p id="render-status" role="status">3D wird geladen …</p>
      <div class="view-label" id="view-label">Gesamt · Arbeitsmodell A</div>
    </div>

    <div id="operation-panel" class="operation-panel" hidden><button id="play" aria-pressed="false">Rad laufen lassen</button><label>Drehzahl<input id="rotation-speed" type="range" min=".2" max="5" step=".1" value="2.2"/></label><label>Wasserstand zur Achse<input id="water-level" type="range" min="-2.2" max="-1.5" step=".05" value="-1.95"/></label><p id="operation-status" role="status"></p><small>Funktionsvisualisierung: Aufnahme, Anheben und Ausschütten. Drehzahl, Wasserstand, Fließrichtung und Übergabefenster sind Annahmen; keine Strömungsberechnung.</small></div>
    <div id="evidence-comparison" hidden><label>Mit Quellen vergleichen<select id="comparison-source"><option value="current">Heutiger Zustand · Originalfoto</option><option value="historical">Historischer Radkreis · Zeichnung</option><option value="arm">Historischer Arm · gekröpftes Profil</option></select></label><figure><a id="comparison-link" target="_blank" rel="noopener"><img id="comparison-image" alt="Quellenvergleich" loading="lazy"/></a><figcaption id="comparison-caption"></figcaption></figure></div>
    <p id="evidence-key" hidden>Holz: rekonstruierte Form · Grau: angenähertes Tragwerk · Ocker: offene Verbindung. Aktuelle Messwerte fehlen. Alte Radien und Profile sind historische Referenzen.</p>
    <div class="quick-layers">
      <label><input type="checkbox" id="layer-model" checked/> Radkörper</label>
      <label><input type="checkbox" id="layer-stationary" checked/> Tragwerk / Rahmen</label>
      <label><input type="checkbox" id="layer-questions"/> offene Stellen</label>
      <label><input type="checkbox" id="layer-scan"/> Scan-Arbeitsplatz</label>
      <label class="hidden-control"><input type="checkbox" id="layer-historical"/> Arbeitskontur</label>
    </div>

    <p id="scan-status" role="status" class="scan-summary">Punktewolke aus · noch keine mechanische Registrierung.</p>

    <details class="technical-settings">
      <summary>Darstellung und Konstruktionsvarianten</summary>
      <div class="technical-grid">
<div><h3>Synthetische Betriebsvarianten</h3><label>Überlappung<select id="overlap-direction"><option value="1">A · Modellannahme</option><option value="-1">B · Gegenrichtung prüfen</option></select></label><label>Ausfluss (Kandidat)<select id="jet-speed"><option value="1.8">1,8 m/s · Modellannahme</option><option value="1">1,0 m/s · Vergleich</option><option value="0">0 m/s · nur Raddrehung</option></select></label><label>Schaufelfläche<select id="paddle-pitch"><option value="0">X + radial · Kandidat</option><option value="15">15° Anstellung · Alternative</option><option value="90">X + tangential · V2-Vergleich</option></select></label></div>
        <div>
          <h3>Welle / Arme</h3>
          <label>Armverlauf
            <select id="arm-shape">
              <option value="unknown">Verlauf offen · Kandidatenkontur</option>
              <option value="straight">gerade Reparaturvariante</option>
              <option value="dogleg" selected>historisch gekröpft</option>
            </select>
          </label>
          <label>Axiale Lage
            <select id="arm-layers">
              <option value="staggered">versetzt – Arbeitsannahme</option>
              <option value="coplanar">gleiche Ebene – Alternative</option>
              <option value="reverse">umgekehrter Versatz – Alternative</option>
            </select>
          </label>
          <label>Verbindung im Inneren<select id="joinery"><option value="staggered">1 · axial getrennte Durchsteckarme</option><option value="independent">2 · getrennte Einsteckarme</option><option value="crossing">3 · kreuzende Arme mit Ausklinkung</option></select></label><p id="candidate-result">Rang 1: durchgehende Arme mit axialem Versatz. Form der Öffnungen, Keile und Endpaarung vor Ort prüfen.</p>
        </div>
        <div>
          <h3>Kumpfstifte</h3>
          <label>Einbau vergleichen<select id="fastener-variant"><option value="A">A · gleichhohe Lochpaare</option><option value="B">B · Einsteckrichtung umkehren</option><option value="C">C · Kreuzpaarung (nachrangig)</option></select></label><p id="fastener-note">Zwei Nägel befestigen am Krümmling; lang/kurz wegen Überlappung. Exakter Weg bleibt Kandidat.</p>
          <h3>Darstellung</h3>
          <div class="model-controls">
            <button id="orbit" aria-pressed="true">Modell bewegen: an</button>
            <button id="explode" aria-pressed="false">Auseinanderziehen: aus</button>
            <button id="cut" aria-pressed="false">Halbschnitt: aus</button>
            <button id="variant" aria-pressed="false">Kumpf-Variante A · 24 mm</button>
          </div>
          <label>Explosionsabstand<input id="explode-factor" type="range" min="0" max="1.5" step=".05" value="1"/></label><label>Schnittlage<input id="cut-offset" type="range" min="-2.5" max="2.5" step=".05" value="0"/></label><p id="variant-note">22 und 24 mm sind alte Varianten. Welche am heutigen Rad vorkommt, muss am Teil geprüft werden.</p>
        </div>
      </div>

      <details id="scan-settings" class="scan-advanced" hidden>
        <summary>Scan ausrichten und prüfen</summary><label>Originalexport<select id="scan-source"><option value="ply">Punktewolke · PLY</option><option value="glb">Oberflächenmodell · GLB</option></select></label>
        <p>Die Exportachsen werden korrigiert. Eine Deckung mit dem Arbeitsmodell wird erst behauptet, wenn Referenzpunkte und Maßstab am Rad aufgenommen wurden.</p>
        <label>Vergleichszustand
          <select id="scan-stage">
            <option value="RAW_EXPORT">Rohscan</option>
            <option value="AXIS_NORMALIZED" selected>Achsen korrigiert</option>
            <option value="ROUGH_ALIGNED">grob ausgerichtet</option>
          </select>
        </label>
        <details>
          <summary>Numerische Ausrichtung</summary>
          <div class="field-grid">
            <label>X-Verschiebung<input id="scan-x" type="number" value="0" step="0.1"/></label>
            <label>Y-Verschiebung<input id="scan-y" type="number" value="0" step="0.1"/></label>
            <label>Z-Verschiebung<input id="scan-z" type="number" value="0" step="0.1"/></label>
            <label>Skalenfaktor<input id="scan-scale" type="number" value="1" min="0.01" max="100" step="0.1"/></label>
            <label>Drehung X (°)<input id="scan-rx" type="number" value="0" step="5"/></label>
            <label>Drehung Y (°)<input id="scan-ry" type="number" value="0" step="5"/></label>
            <label>Drehung Z (°)<input id="scan-rz" type="number" value="0" step="5"/></label>
          </div>
          <button id="scan-reset">Scanvergleich zurücksetzen</button>
        </details>
      <details class="datum-solver"><summary>Nach der Aufnahme: Referenzpunkte berechnen</summary><p>Drei nicht geradlinige Referenzpunkte, zwei Achspunkte und eine unabhängige Kontrollstrecke in Metern. Ergebnis bleibt ein Prüfvorschlag.</p><label>Technischer Datensatz (JSON)<textarea id="datum-input" rows="5" placeholder='{"source":[[0,0,0],[1,0,0],[0,1,0]],"target":[[0,0,0],[1,0,0],[0,1,0]],"axisSource":[[0,0,0],[1,0,0]],"axisTarget":[[0,0,0],[1,0,0]],"control":{"source":[[0,0,0],[0,0,1]],"measured":1,"tolerance":0.005}}'></textarea></label><button id="solve-registration">Transformation prüfen</button><p id="registration-result" role="status"></p></details>
      </details>
    </details>
  </section>

  <section class="wb-inspect">
    <div class="part-column" id="parts">
      <div class="section-head">
        <div><span class="eyebrow">Teil auswählen</span><h2>Wo sollen wir genauer hinsehen?</h2></div>
      </div>
      <label for="part-search">Teilname oder Werkstattbegriff</label>
      <input id="part-search" type="search" placeholder="z. B. Kumpf, Krümmling, Keil, Arm"/>
      <div id="part-list" class="part-list"></div>
    </div>
    <aside id="selection" class="selection-panel" aria-live="polite"></aside>
  </section>

  <details class="capture-shell" id="capture">
    <summary>Befund am ausgewählten Teil festhalten</summary>
    <div class="capture-inner">
      <div class="section-head"><h2 id="capture-heading">Foto, Maß oder Werkstattwissen</h2><span id="draft-status" role="status"></span></div>
      <p id="capture-context"></p>
      <div id="capture-actions" class="action-row">
        <button data-kind="measurement">Messen</button>
        <button data-kind="observation">Foto / Beobachtung</button>
        <button data-kind="identification">Teil / Variante</button>
        <button data-kind="expert-narrative">Erfahrung</button>
        <button data-kind="risk">Warnsignal / Risiko</button>
      </div>
      <form id="capture-form">
        <p id="step-indicator">Schritt 1 von 3 · Befund</p>
        <fieldset data-step="1">
          <legend>Befund</legend>
          <label>Art<select name="kind"><option value="measurement">Messung</option><option value="observation">Beobachtung</option><option value="identification">Identifikation / Variante</option><option value="expert-narrative">Werkstatterfahrung</option><option value="risk">Warnsignal / Risiko</option></select></label>
          <label>Offene Frage<select name="question_id"></select></label>
          <label>Was wurde gesehen oder gemessen?<textarea name="feature" required rows="2"></textarea></label>
          <div data-kinds="measurement" class="field-grid">
            <label>Wert<input name="value" type="number" step="any"/></label><label>Einheit<select name="unit"><option>mm</option><option>cm</option><option>m</option><option>°</option><option>Stück</option></select></label>
            <label>Endpunkt A<input name="endpoint_a"/></label><label>Endpunkt B<input name="endpoint_b"/></label>
            <label>Werkzeug<input name="tool"/></label><label>Unsicherheit ±<input name="uncertainty" type="number" min="0" step="any"/></label>
          </div>
          <div data-kinds="identification"><label>Reale Teil-ID<input name="physical_id" placeholder="KS-KUM-001"/></label><label>Variante<select name="variant"><option value="unknown">Verlauf offen · Kandidatenkontur</option><option value="A">A · 24 mm</option><option value="B">B · 22 mm</option><option value="other">andere Variante</option></select></label></div>
          <div data-kinds="expert-narrative,risk"><label>Wörtliche Aussage<textarea name="quote" rows="3"></textarea></label><label>Technische Deutung – getrennt davon<textarea name="interpretation" rows="2"></textarea></label></div>
          <div data-kinds="risk"><label>Thema<select name="risk_topic"><option value="RISK-MOISTURE">Quellen / Schwinden</option><option value="RISK-FIT">Keile / Passung</option><option value="RISK-LOAD">Strömung / Stoßlast</option><option value="RISK-WEAR">Verschleiß</option><option value="RISK-REPAIR">Reparaturpraxis</option><option value="RISK-SIGN">Warnsignale</option></select></label><div class="field-grid"><label>Auslöser / Zustand<input name="trigger"/></label><label>Mechanismus<input name="mechanism"/></label><label>Erwartetes Verhalten<input name="expected_behaviour"/></label><label>Fehlerfolge<input name="failure_consequence"/></label><label>Warnsignal<input name="warning_sign"/></label><label>Abhilfe / Reparatur<input name="mitigation"/></label><label>Abweichende Erinnerung<input name="alternate_account"/></label></div></div>
          <label class="check"><input type="checkbox" name="unknown"/>Noch nicht bekannt / nicht zugänglich</label>
        </fieldset>

        <fieldset data-step="2" hidden>
          <legend>Kontext</legend>
          <div class="field-grid">
            <label>Person / Rolle<input name="person" required/></label><label>Ereignis-ID<input name="event_id" placeholder="EVT-001" required/></label>
            <label>Seite<select name="side"><option value="UNKNOWN">noch nicht zugeordnet</option><option value="LAND">Landseite – bestätigt</option><option value="WATER">Wasserseite – bestätigt</option></select></label>
            <label>Zustand<select name="state"><option value="installed">eingebaut</option><option value="during-release">beim Lösen</option><option value="removed">ausgebaut</option></select></label>
            <label>Partner-IDs<input name="partners"/></label><label>Verbindung<select name="relation_id"><option value="">noch nicht zugeordnet</option></select></label>
            <label>Orientierung / Befestiger<input name="orientation"/></label><label>Lagerplatz<input name="storage_location"/></label>
            <label>Sicherheit der Aussage<select name="confidence"><option value="unknown">offen</option><option value="low">niedrig</option><option value="medium">mittel</option><option value="high">hoch</option></select></label>
            <label>Medienrolle<select name="media_role"><option value="context">Übersicht</option><option value="before">vor dem Lösen</option><option value="after">nach dem Öffnen</option><option value="measurement">Messstelle</option></select></label>
          </div>
          <label>Foto aufnehmen oder Datei wählen<span class="file-pick"><input id="media-input" type="file" accept="image/jpeg,image/png,image/webp" capture="environment" multiple/><span>Datei auswählen</span></span></label>
          <p id="media-status"></p><div id="media-list"></div>
          <label>Externe Audio-/Video-Datei<input name="media_reference"/></label>
        </fieldset>

        <fieldset data-step="3" hidden>
          <legend>Gemeinsam zuordnen</legend>
          <label>Bezug auf vorhandene Aussage<select name="claim_id"><option value="">keine konkrete Aussage</option></select></label>
          <label>Was bedeutet der Befund?<select name="effect"><option value="context">ergänzt unser Bild</option><option value="supports">bestätigt die ausgewählte Aussage</option><option value="challenges">passt nicht zur ausgewählten Aussage</option></select></label>
          <div id="review"></div>
          <p class="notice">Der Eintrag bleibt ungeprüft, bis er gemeinsam abgeglichen wurde. Ein Maß wird dadurch nicht automatisch freigegeben.</p>
        </fieldset>

        <p id="form-error" role="alert"></p>
        <div class="action-row"><button type="button" id="step-back" hidden>Zurück</button><button type="button" id="step-next">Weiter</button><button type="submit" id="save-record" hidden>Lokal speichern</button></div>
      </form>
    </div>
  </details>

  <section id="records" class="records-shell">
    <div class="section-head"><div><span class="eyebrow">Arbeitsprotokoll</span><h2>Gesicherte Befunde <small><span id="record-count">0</span> Einträge</small></h2></div><button id="export">Sicherung als JSON</button></div>
    <label>Sicherung wieder einlesen<span class="file-pick"><input id="import" type="file" accept="application/json,.json"/><span>Datei auswählen</span></span></label>
    <div id="record-list"></div>
  </section>

  <section id="drawings" class="drawing-shell">
    <div class="section-head"><div><span class="eyebrow">Papier</span><h2>Werkstatt- und Aufnahmeplan</h2></div><a class="plan-button" href={href('field-pack/KS-Werkstatt-Aufnahmeplan-A3.pdf')}>A3-Arbeitsplan öffnen</a></div>
    <p>Für die Demontage ist der Arbeitsplan die primäre Führung. Die digitalen Zeichnungen bleiben ergänzende Prüfansichten.</p>
    <div class="drawing-links">{['KS-00','KS-10','KS-20','KS-30','KS-40','KS-50','KS-60','KS-70'].map(id=><a href={href(`drawings/${id}.svg`)} target="_blank">{id} · Prüfblatt</a>)}</div>
  </section>

  <footer>Arbeitsstand vor der Demontage 2026 · <a href="https://github.com/jdistlr/kleines-schaeferrad">Technisches Repository</a></footer>
</main>
<script>import '../workbench/client.js';</script>
</body>
</html>
